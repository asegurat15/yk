<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_journal_form_kabay_consumer_invoice" model="ir.ui.view">
        <field name="name">account.journal.form.kabay.consumer.invoice</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type']" position="after">
                <field name="kabay_force_consumer_invoice_title"
                       invisible="type != 'sale' or country_code != 'DO'"/>
            </xpath>
        </field>
    </record>
</odoo>
