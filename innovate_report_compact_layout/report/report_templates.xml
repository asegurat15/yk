    <template id="report_invoice_document_compact"
              inherit_id="kabay_invoice_report_pro.report_invoice_document_kabay_pro"
              name="Innovate Invoice Compact Layout"
              priority="90">
      <xpath expr="//div[contains(concat(' ', normalize-space(@class), ' '), ' kabay-logo-band ')]"
             position="replace">
        <t t-set="innovate_company_partner" t-value="o.company_id.partner_id"/>
        <table class="innovate-compact-header-table avoid-page-break-inside">
          <tbody>
            <tr>
              <td class="innovate-compact-logo-cell">
                <img t-if="o.company_id.logo"
                     t-att-src="image_data_uri(o.company_id.logo)"
                     class="kabay-company-logo innovate-compact-logo"
                     alt="Logo"/>
              </td>
              <td class="innovate-compact-company-cell">
                <div t-if="innovate_company_partner.name"
                     class="innovate-inline-name"
                     t-field="innovate_company_partner.name"/>
                <div t-if="innovate_company_partner.phone or innovate_company_partner.vat"
                     class="innovate-company-contact">
                  <span t-if="innovate_company_partner.phone">
                    <span class="kabay-label">Tel.:</span>
                    <span t-field="innovate_company_partner.phone"/>
                  </span>
                  <span t-if="innovate_company_partner.phone and innovate_company_partner.vat"
                        class="innovate-company-contact-separator"> · </span>
                  <span t-if="innovate_company_partner.vat">
                    <span class="kabay-label">RNC:</span>
                    <span t-field="innovate_company_partner.vat"/>
                  </span>
                </div>
                <div t-if="innovate_company_partner.street or innovate_company_partner.street2 or innovate_company_partner.city or innovate_company_partner.state_id or innovate_company_partner.zip or innovate_company_partner.country_id"
                     class="innovate-inline-details innovate-company-address">
                  <span t-if="innovate_company_partner.street"
                        class="innovate-inline-item"
                        t-field="innovate_company_partner.street"/>
                  <span t-if="innovate_company_partner.street2"
                        class="innovate-inline-item"
                        t-field="innovate_company_partner.street2"/>
                  <span t-if="innovate_company_partner.city"
                        class="innovate-inline-item"
                        t-field="innovate_company_partner.city"/>
                  <span t-if="innovate_company_partner.state_id"
                        class="innovate-inline-item"
                        t-field="innovate_company_partner.state_id"/>
                  <span t-if="innovate_company_partner.zip"
                        class="innovate-inline-item"
                        t-field="innovate_company_partner.zip"/>
                  <span t-if="innovate_company_partner.country_id"
                        class="innovate-inline-item"
                        t-field="innovate_company_partner.country_id"/>
                </div>
              </td>
            </tr>
          </tbody>
        </table>
      </xpath>

      <!-- Company data moved beside the logo; keep invoice dates below it. -->
      <xpath expr="//table[contains(concat(' ', normalize-space(@class), ' '), ' kabay-main-head ')]/tbody/tr/td[1]/div[contains(concat(' ', normalize-space(@class), ' '), ' kabay-company-address ')]"
             position="replace"/>
      <xpath expr="//table[contains(concat(' ', normalize-space(@class), ' '), ' kabay-main-head ')]/tbody/tr/td[1]/div[@t-if='o.company_id.vat']"
             position="replace"/>

      <xpath expr="//table[contains(concat(' ', normalize-space(@class), ' '), ' kabay-party-table ')]"
             position="replace">
        <table class="kabay-party-table innovate-compact-customer-table avoid-page-break-inside">
          <tbody>
            <tr>
              <td class="kabay-left-column">
                <div name="no_shipping" class="innovate-customer-details">
                  <div t-if="o.partner_id.name" class="innovate-customer-line innovate-customer-name">
                    <span class="kabay-label" t-out="kabay['customer_label'] + ':'"/>
                    <span t-field="o.partner_id.name"/>
                  </div>
                  <div t-if="o.partner_id.phone or o.partner_id.vat"
                       class="innovate-customer-line innovate-customer-contact">
                    <span t-if="o.partner_id.phone">
                      <span class="kabay-label">Tel.:</span>
                      <span t-field="o.partner_id.phone"/>
                    </span>
                    <span t-if="o.partner_id.phone and o.partner_id.vat" class="innovate-customer-contact-separator"> · </span>
                    <span t-if="o.partner_id.vat" id="partner_vat_no_shipping">
                      <span class="kabay-label">RNC:</span>
                      <span t-field="o.partner_id.vat"/>
                    </span>
                  </div>
                  <div t-if="o.partner_id.street or o.partner_id.street2 or o.partner_id.city or o.partner_id.state_id or o.partner_id.zip or o.partner_id.country_id"
                       class="innovate-inline-details innovate-customer-address">
                    <span t-if="o.partner_id.street" class="innovate-inline-item" t-field="o.partner_id.street"/>
                    <span t-if="o.partner_id.street2" class="innovate-inline-item" t-field="o.partner_id.street2"/>
                    <span t-if="o.partner_id.city" class="innovate-inline-item" t-field="o.partner_id.city"/>
                    <span t-if="o.partner_id.state_id" class="innovate-inline-item" t-field="o.partner_id.state_id"/>
                    <span t-if="o.partner_id.zip" class="innovate-inline-item" t-field="o.partner_id.zip"/>
                    <span t-if="o.partner_id.country_id" class="innovate-inline-item" t-field="o.partner_id.country_id"/>
                  </div>
                </div>
              </td>
              <td class="kabay-right-column">

                <t t-if="o.partner_shipping_id and (o.partner_shipping_id != o.partner_id)">
                  <div groups="account.group_delivery_invoice_address" name="shipping_address_block">
                      <strong class="d-block mt-3">Shipping Address</strong>
                      <div t-field="o.partner_shipping_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                  </div>

                </t>

                <div t-if="kabay['quotation_code']" name="invoice_origin">
                  <span class="kabay-label">Código de cotización:</span>
                  <span t-out="kabay['quotation_code']"/>
                </div>
                <div t-if="kabay['payment_term']">
                  <span class="kabay-label">Condiciones:</span>
                  <span t-out="kabay['payment_term']"/>
                </div>
              </td>
            </tr>
          </tbody>
        </table>
      </xpath>

<!--      <xpath expr="//div[contains(concat(' ', normalize-space(@class), ' '), ' kabay-terms-section ')]"-->
<!--             position="replace">-->
<!--        <div t-if="kabay['company_terms']"-->
<!--             name="comment"-->
<!--             class="kabay-terms-section innovate-compact-terms avoid-page-break-inside">-->
<!--          <div class="kabay-narration innovate-terms-flow" t-out="kabay['company_terms']"/>-->
<!--        </div>-->
<!--      </xpath>-->
<!--      <xpath expr="//div[@id='payment_term']" position="attributes">-->
<!--        <attribute name="class" add="innovate-compact-payment-term" separator=" "/>-->
<!--      </xpath>-->
    </template>

    <template id="report_invoice_document_new_compact"
              inherit_id="kabay_invoice_report_pro.report_invoice_document_kabay_new"
              name="Innovate New Invoice Compact Layout"
              priority="90">
      <xpath expr="//div[contains(concat(' ', normalize-space(@class), ' '), ' kabay-new-invoice-logo-area ')]"
             position="replace">
        <t t-set="innovate_company_partner" t-value="o.company_id.partner_id"/>
        <table class="innovate-compact-header-table avoid-page-break-inside">
          <tbody>
            <tr>
              <td class="innovate-compact-logo-cell">
                <img t-if="o.company_id.logo"
                     t-att-src="image_data_uri(o.company_id.logo)"
                     class="kabay-new-invoice-logo innovate-compact-logo"
                     alt="Logo"/>
              </td>
              <td class="innovate-compact-company-cell">
                <div t-if="innovate_company_partner.name"
                     class="innovate-inline-name"
                     t-field="innovate_company_partner.name"/>
                <div t-if="innovate_company_partner.phone or innovate_company_partner.vat"
                     class="innovate-company-contact">
                  <span t-if="innovate_company_partner.phone">
                    <span class="kabay-new-invoice-label">Tel.:</span>
                    <span t-field="innovate_company_partner.phone"/>
                  </span>
                  <span t-if="innovate_company_partner.phone and innovate_company_partner.vat"
                        class="innovate-company-contact-separator"> · </span>
                  <span t-if="innovate_company_partner.vat">
                    <span class="kabay-new-invoice-label">RNC:</span>
                    <span t-field="innovate_company_partner.vat"/>
                  </span>
                </div>
                <div t-if="innovate_company_partner.street or innovate_company_partner.street2 or innovate_company_partner.city or innovate_company_partner.state_id or innovate_company_partner.zip or innovate_company_partner.country_id"
                     class="innovate-inline-details innovate-company-address">
                  <span t-if="innovate_company_partner.street" class="innovate-inline-item" t-field="innovate_company_partner.street"/>
                  <span t-if="innovate_company_partner.street2" class="innovate-inline-item" t-field="innovate_company_partner.street2"/>
                  <span t-if="innovate_company_partner.city" class="innovate-inline-item" t-field="innovate_company_partner.city"/>
                  <span t-if="innovate_company_partner.state_id" class="innovate-inline-item" t-field="innovate_company_partner.state_id"/>
                  <span t-if="innovate_company_partner.zip" class="innovate-inline-item" t-field="innovate_company_partner.zip"/>
                  <span t-if="innovate_company_partner.country_id" class="innovate-inline-item" t-field="innovate_company_partner.country_id"/>
                </div>
              </td>
            </tr>
          </tbody>
        </table>
      </xpath>

      <!-- Company data moved beside the logo; keep the emission date below. -->
      <xpath expr="//table[contains(concat(' ', normalize-space(@class), ' '), ' kabay-new-invoice-header-table ')]/tbody/tr/td[1]/div[contains(concat(' ', normalize-space(@class), ' '), ' kabay-new-invoice-company-details-source ')]"
             position="replace"/>
      <xpath expr="//table[contains(concat(' ', normalize-space(@class), ' '), ' kabay-new-invoice-header-table ')]/tbody/tr/td[1]/div[@t-if='o.company_id.vat']"
             position="replace"/>

      <xpath expr="//table[contains(concat(' ', normalize-space(@class), ' '), ' kabay-new-invoice-customer-table ')]"
             position="replace">
        <table class="kabay-new-invoice-customer-table innovate-compact-customer-table avoid-page-break-inside">
          <tbody>
            <tr>
              <td class="kabay-new-invoice-customer-column">
                <div class="innovate-customer-details">
                  <div t-if="o.partner_id.name" class="innovate-customer-line innovate-customer-name">
                    <span class="kabay-new-invoice-label">Razón Social:</span>
                    <span t-field="o.partner_id.name"/>
                  </div>
                  <div t-if="o.partner_id.phone or o.partner_id.vat"
                       class="innovate-customer-line innovate-customer-contact">
                    <span t-if="o.partner_id.phone">
                      <span class="kabay-new-invoice-label">Tel.:</span>
                      <span t-field="o.partner_id.phone"/>
                    </span>
                    <span t-if="o.partner_id.phone and o.partner_id.vat" class="innovate-customer-contact-separator"> · </span>
                    <span t-if="o.partner_id.vat">
                      <span class="kabay-new-invoice-label">RNC:</span>
                      <span t-field="o.partner_id.vat"/>
                    </span>
                  </div>
                  <div t-if="o.partner_id.street or o.partner_id.street2 or o.partner_id.city or o.partner_id.state_id or o.partner_id.zip or o.partner_id.country_id"
                       class="innovate-inline-details innovate-customer-address">
                    <span t-if="o.partner_id.street" class="innovate-inline-item" t-field="o.partner_id.street"/>
                    <span t-if="o.partner_id.street2" class="innovate-inline-item" t-field="o.partner_id.street2"/>
                    <span t-if="o.partner_id.city" class="innovate-inline-item" t-field="o.partner_id.city"/>
                    <span t-if="o.partner_id.state_id" class="innovate-inline-item" t-field="o.partner_id.state_id"/>
                    <span t-if="o.partner_id.zip" class="innovate-inline-item" t-field="o.partner_id.zip"/>
                    <span t-if="o.partner_id.country_id" class="innovate-inline-item" t-field="o.partner_id.country_id"/>
                  </div>
                </div>
              </td>
              <td class="kabay-new-invoice-origin-column">
                <div t-if="kabay_new['origin']">
                  <span class="kabay-new-invoice-label">Origen:</span>
                  <span t-out="kabay_new['origin']"/>
                </div>
              </td>
            </tr>
          </tbody>
        </table>
      </xpath>

      <xpath expr="//div[contains(concat(' ', normalize-space(@class), ' '), ' kabay-new-invoice-commercial-notes ')]"
             position="replace">
        <div t-if="kabay_new['company_terms']"
             class="kabay-new-invoice-commercial-notes innovate-compact-terms avoid-page-break-inside">
          <div class="kabay-new-invoice-commercial-notes-line innovate-terms-flow"
               t-out="kabay_new['company_terms']"/>
        </div>
      </xpath>
      <xpath expr="//div[contains(concat(' ', normalize-space(@class), ' '), ' kabay-new-invoice-payment-term ')]"
             position="attributes">
        <attribute name="class" add="innovate-compact-payment-term" separator=" "/>
      </xpath>
    </template>
